# .env.example — Copy to .env and fill in your values
# Databricks workspace and authentication
DATABRICKS_HOST="https://<your-workspace>.azuredatabricks.net"
DATABRICKS_TOKEN="<your-personal-access-token>"

# Unity Catalog
DATABRICKS_CATALOG="catalog"
DATABRICKS_SCHEMA="data"
DATABRICKS_TABLE="aef_embeddings"

# Workspace paths
DATABRICKS_INIT_SCRIPT_PATH="/Workspace/Shared/aef-bng/init-scripts"
DATABRICKS_WHEEL_VOLUME_PATH="/Volumes/<your-catalog>/dependencies/whl"

# Cluster configuration
DATABRICKS_NODE_TYPE="Standard_DS4_v2"
DATABRICKS_SPARK_VERSION="17.3.x-scala2.12"
DATABRICKS_MIN_WORKERS="1"
DATABRICKS_MAX_WORKERS="10"

# Pipeline defaults
AEF_BNG_BOUNDS="0,0,700000,1300000"
AEF_BNG_YEARS="2025"
AEF_BNG_RESAMPLING="nearest"
